{
 "$4d": {
  "version": "1",
  "kind": "form"
 },
 "windowSizingX": "fixed",
 "windowSizingY": "fixed",
 "windowMinWidth": 1180,
 "windowMinHeight": 860,
 "windowMaxWidth": 1180,
 "windowMaxHeight": 860,
 "rightMargin": 0,
 "bottomMargin": 0,
 "events": [
  "onLoad",
  "onUnload"
 ],
 "windowTitle": "Spooler Console",
 "destination": "detailScreen",
 "method": "method.4dm",
 "formClass": "SpoolerConsole",
 "pages": [
  {
   "objects": {}
  },
  {
   "objects": {
    "pageBg": {
     "type": "rectangle",
     "left": 0,
     "top": 0,
     "width": 1180,
     "height": 860,
     "class": "pageBg"
    },
    "header": {
     "type": "rectangle",
     "left": 0,
     "top": 0,
     "width": 1180,
     "height": 78,
     "class": "header"
    },
    "lblTitle": {
     "type": "text",
     "text": "Spooler Console",
     "left": 24,
     "top": 14,
     "width": 420,
     "height": 32,
     "class": "title"
    },
    "lblTagline": {
     "type": "text",
     "text": "Every panel is a decoded answer from miyako/spooler-monitor 0.1.1 — nothing is simulated.",
     "left": 24,
     "top": 48,
     "width": 560,
     "height": 18,
     "class": "headerDim"
    },
    "inpComponent": {
     "type": "input",
     "dataSource": "Form.componentLine",
     "left": 596,
     "top": 12,
     "width": 560,
     "height": 18,
     "dataSourceTypeHint": "text",
     "enterable": false,
     "hideFocusRing": true,
     "class": "headerDim monoSmall",
     "borderStyle": "none",
     "fill": "transparent"
    },
    "inpCapability": {
     "type": "input",
     "dataSource": "Form.capabilityLine",
     "left": 596,
     "top": 32,
     "width": 560,
     "height": 18,
     "dataSourceTypeHint": "text",
     "enterable": false,
     "hideFocusRing": true,
     "class": "headerDim monoSmall",
     "borderStyle": "none",
     "fill": "transparent"
    },
    "inpEnv": {
