     "left": 38,
     "top": 118,
     "width": 664,
     "height": 250,
     "rowHeight": "26px",
     "verticalAlign": "middle",
     "resizingMode": "legacy",
     "currentItemPositionSource": "Form.selectedPos",
     "events": [
      "onSelectionChange",
      "onDoubleClick"
     ],
     "method": "ObjectMethods/lbQueues.4dm",
     "columns": [
      {
       "name": "id",
       "dataSource": "This.id",
       "width": 150,
       "truncateMode": "none",
       "header": {
        "name": "hdrid",
        "text": "id (exact, for mutations)"
       },
       "minWidth": 120
      },
      {
       "name": "displayName",
       "dataSource": "This.displayName",
       "width": 170,
       "truncateMode": "none",
       "header": {
        "name": "hdrdisplayName",
        "text": "displayName (label)"
       },
       "minWidth": 120
      },
      {
       "name": "state",
       "dataSource": "This.stateLabel",
       "width": 62,
       "truncateMode": "none",
       "header": {
        "name": "hdrstate",
        "text": "state"
       },
       "minWidth": 60
      },
      {
       "name": "jobs",
       "dataSource": "This.jobsLabel",
       "width": 46,
       "truncateMode": "none",
       "header": {
        "name": "hdrjobs",
        "text": "jobs"
       },
       "minWidth": 44
      },
      {
       "name": "accepting",
       "dataSource": "This.acceptingLabel",
       "width": 74,
       "truncateMode": "none",
       "header": {
        "name": "hdraccepting",
        "text": "accepting"
       },
       "minWidth": 70
      },
      {
       "name": "reasons",
       "dataSource": "This.reasonsLabel",
       "width": 118,
       "truncateMode": "none",
       "header": {
        "name": "hdrreasons",
        "text": "reasons"
       },
       "minWidth": 90
      }
     ],
     "class": "listInk"
    },
