     "enterable": false,
     "hideFocusRing": true,
     "class": "headerDim monoSmall",
     "borderStyle": "none",
     "fill": "transparent"
    },
    "grpQueues": {
     "type": "groupBox",
     "text": "1 · Queues — one snapshot per call",
     "left": 20,
     "top": 92,
     "width": 700,
     "height": 338,
     "class": "ink"
    },
    "lbQueues": {
     "type": "listbox",
     "listboxType": "collection",
